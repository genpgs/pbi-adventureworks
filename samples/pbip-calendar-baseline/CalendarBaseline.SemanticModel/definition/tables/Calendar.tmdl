	column Is53WeekYear
		dataType: string
		lineageTag: b5fa8c6b-4ac7-43b7-a6ef-cdc705252162
		summarizeBy: none
		sourceColumn: Is53WeekYear

		annotation SummarizationSetBy = Automatic

	column YearMonthSort
		dataType: int64
		lineageTag: YearMonthSort
		summarizeBy: none
		sourceColumn: YearMonthSort

	column YearMonth
		dataType: string
		lineageTag: YearMonth
		summarizeBy: none
		sourceColumn: YearMonth
		sortByColumn: YearMonthSort

	partition Calendar = m
		mode: import
		source =
				let
				    // ── Configuration ──────────────────────────────────────────────────
				    // Change WeekPattern to "454", "544", or "13period" as needed.
				    // Change FiscalYearStartDate and WeekStartDay to match your business.
				    //
				    // FiscalYearStartDate MUST be a WeekStartDay on or before the first
				    // fact date, otherwise the Calendar relationship matches nothing and
				    // every Calendar-bound visual renders blank. Sample FactSales spans
				    // 2024-01-15 .. 2025-09-04, so FY1 opens on the Saturday on/before
				    // the first fact day.
				    FiscalYearStartDate = #date(2024, 1, 13),
				    WeekPattern         = "445",
				    WeekStartDay        = "Saturday",
				    NumberOfYears       = 4,
				    LabelMode           = "endingYear",
				    Culture             = "en-US",
				
				    // Generate the calendar
				    Calendar    = fnCalendarWeekBased(FiscalYearStartDate, NumberOfYears, WeekPattern, WeekStartDay, Culture, LabelMode)
				in
				    Calendar

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

