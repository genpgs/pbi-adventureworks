# Power BI local artifacts (never commit these)
# The entire .pbi/ tree is per-user/per-machine runtime state, not definition data.
**/.pbi/
*.pbix
# Diagram layouts are regenerated by Desktop from the model; they churn on every save.
**/diagramLayout.json
**/semanticModelDiagramLayout.json
# Local sample data (large binaries; regenerate or fetch separately)
data/*.xlsx
data/*.csv
data/*.parquet

# Agent validation output (regenerate, never commit)
.bpa/
bpa-results.json
*-audit-report.md
*-audit-report.json

# Rendered-output verification (scripts/capture_report_screenshot.py, Windows-only).
# Regenerate locally; PNGs are throwaway evidence, not source.
artifacts/

# Environment / secrets
.env
secrets/

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Node
node_modules/
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.swo

# Generated audit reports (regenerate with scripts/, never commit)
PBIP_STRUCTURE_COMPARISON_REPORT.md

# Cached Microsoft PBIR schemas fetched by validate_pbir_ms_schema.py / validate_pbir_ajv.js
.cache/
