expression fnCalendar =
		(StartDate as nullable date, EndDate as nullable date, optional FiscalYearStartMonth as nullable number, optional FiscalYearLabelMode as nullable text, optional Culture as nullable text) as table =>
		let
		    FiscalStartMonth  = if FiscalYearStartMonth = null then 1 else Number.RoundDown(FiscalYearStartMonth),
		    ValidFiscalMonth  = if FiscalStartMonth >= 1 and FiscalStartMonth <= 12 then FiscalStartMonth else error "FiscalYearStartMonth must be between 1 and 12.",
		    LabelMode         = if FiscalYearLabelMode = null or FiscalYearLabelMode = "" then "endingYear" else FiscalYearLabelMode,
		    CalendarCulture   = if Culture = null or Text.Trim(Culture) = "" then "en-US" else Culture,
		    CheckedStart      = if StartDate = null then error "StartDate cannot be null." else Date.From(StartDate),
		    CheckedEnd        = if EndDate = null then error "EndDate cannot be null." else Date.From(EndDate),
		    RangeCheck        = if CheckedEnd < CheckedStart then error "EndDate must be on or after StartDate." else null,
		    FYStart = (d as date) as date => if Date.Month(d) >= ValidFiscalMonth then #date(Date.Year(d), ValidFiscalMonth, 1) else #date(Date.Year(d)-1, ValidFiscalMonth, 1),
		    RangeStart  = FYStart(CheckedStart),
		    RangeEnd    = Date.AddDays(Date.AddYears(FYStart(CheckedEnd), 1), -1),
		    Dates       = List.Dates(RangeStart, Duration.Days(RangeEnd-RangeStart)+1, #duration(1,0,0,0)),
		    T   = Table.TransformColumnTypes(Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}), {{"Date", type date}}),
		    DK  = Table.AddColumn(T,  "DateKey",             each Date.Year([Date])*10000+Date.Month([Date])*100+Date.Day([Date]), Int64.Type),
		    Y   = Table.AddColumn(DK, "Year",                each Date.Year([Date]),  Int64.Type),
		    MN  = Table.AddColumn(Y,  "MonthNumber",         each Date.Month([Date]), Int64.Type),
		    M   = Table.AddColumn(MN, "Month",               each Date.MonthName([Date], CalendarCulture), type text),
		    YM  = Table.AddColumn(M,  "YearMonth",           each Date.ToText([Date], "yyyy-MM", CalendarCulture), type text),
		    YMS = Table.AddColumn(YM, "YearMonthSort",       each [Year]*100+[MonthNumber], Int64.Type),
		    FYS = Table.AddColumn(YMS,"FiscalYearStartDate", each FYStart([Date]), type date),
		    FYE = Table.AddColumn(FYS,"FiscalYearEndDate",   each Date.AddDays(Date.AddYears([FiscalYearStartDate],1),-1), type date),
		    FYN = Table.AddColumn(FYE,"_FYEndYear",          each Date.Year([FiscalYearEndDate]), Int64.Type),
		    FY  = Table.AddColumn(FYN,"FiscalYear",          each if LabelMode="startingYear" then Date.Year([FiscalYearStartDate]) else [_FYEndYear], Int64.Type),
		    FYL = Table.AddColumn(FY, "FiscalYearLabel",     each "FY" & Text.From([FiscalYear]), type text),
		    FM  = Table.AddColumn(FYL,"FiscalMonthNumber",   each Number.Mod([MonthNumber]-ValidFiscalMonth,12)+1, Int64.Type),
		    FQN = Table.AddColumn(FM, "FiscalQuarterNumber", each Number.RoundUp([FiscalMonthNumber]/3), Int64.Type),
		    FQ  = Table.AddColumn(FQN,"FiscalQuarter",       each "FQ" & Text.From([FiscalQuarterNumber]), type text),
		    Result = if RangeCheck = null then Table.RemoveColumns(FQ, {"_FYEndYear"}) else error "Invalid date range."
		in Result
	lineageTag: fnCalendar

expression fnCalendarWeekBased =
		(FiscalYearStartDate as date, NumberOfYears as number, optional WeekPattern as nullable text, optional WeekStartDay as nullable text, optional Culture as nullable text) as table =>
		let
		    Pattern   = if WeekPattern  = null or WeekPattern  = "" then "445"      else WeekPattern,
		    StartDay  = if WeekStartDay = null or WeekStartDay = "" then "Saturday" else WeekStartDay,
		    Culture_  = if Culture      = null or Culture      = "" then "en-US"    else Culture,
		    NYears    = if NumberOfYears < 1 then error "NumberOfYears must be >= 1." else Number.RoundDown(NumberOfYears),
		    ValidPatterns = {"445", "454", "544", "13period"},
		    _PatternCheck = if List.Contains(ValidPatterns, Pattern) then null else error "WeekPattern must be one of: 445, 454, 544, 13period.",
		    DayOffsetMap = [Saturday = 6, Sunday = 0, Monday = 1],
		    DayOffset    = if Record.HasFields(DayOffsetMap, StartDay) then Record.Field(DayOffsetMap, StartDay) else error "WeekStartDay must be Saturday, Sunday, or Monday.",
		    PeriodPattern_3 = if Pattern = "445" then {4,4,5} else if Pattern = "454" then {4,5,4} else if Pattern = "544" then {5,4,4} else {4},
		    Is13Period  = (Pattern = "13period"),
		    WeeksPerQtr = if Is13Period then 4 else List.Sum(PeriodPattern_3),
		    PeriodsPerYr = if Is13Period then 13 else 12,
		    NominalStart = FiscalYearStartDate,
		    NominalDOW   = Date.DayOfWeek(NominalStart, Day.Sunday),
		    AnchorOffset = Number.Mod(NominalDOW - DayOffset + 7, 7),
		    ActualFY1Start = Date.AddDays(NominalStart, -AnchorOffset),
		    FYStartDates = List.Generate(
		        () => [fy = 1, startD = ActualFY1Start],
		        each [fy] <= NYears,
		        each [
		            fy = [fy] + 1,
		            _nomStart = Date.AddYears(NominalStart, [fy]),
		            _nomDOW   = Date.DayOfWeek(_nomStart, Day.Sunday),
		            _offset   = Number.Mod(_nomDOW - DayOffset + 7, 7),
		            startD    = Date.AddDays(_nomStart, -_offset)
		        ],
		        each [startD]
		    ),
		    LastNominalEnd = Date.AddYears(NominalStart, NYears),
		    LastNominalDOW = Date.DayOfWeek(LastNominalEnd, Day.Sunday),
		    LastOffset     = Number.Mod(LastNominalDOW - DayOffset + 7, 7),
		    CalendarEnd    = Date.AddDays(LastNominalEnd, -LastOffset - 1),
		    TotalDays   = Duration.Days(CalendarEnd - ActualFY1Start) + 1,
		    Dates       = List.Dates(ActualFY1Start, TotalDays, #duration(1,0,0,0)),
		    T           = Table.TransformColumnTypes(Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}), {{"Date", type date}}),
		    DK          = Table.AddColumn(T, "DateKey", each Date.Year([Date])*10000 + Date.Month([Date])*100 + Date.Day([Date]), Int64.Type),
		    CY          = Table.AddColumn(DK, "CalendarYear", each Date.Year([Date]), Int64.Type),
		    CMN         = Table.AddColumn(CY, "CalendarMonthNumber", each Date.Month([Date]), Int64.Type),
		    CM          = Table.AddColumn(CMN, "CalendarMonth", each Date.MonthName([Date], Culture_), type text),
		    DOW         = Table.AddColumn(CM, "DayOfWeek", each Date.DayOfWeekName([Date], Culture_), type text),
		    FYAssignments = Table.AddColumn(DOW, "FiscalYearIndex", each
		        let
		            d = [Date],
		            matching = List.Select(List.Positions(FYStartDates), each d >= FYStartDates{_}),
		            idx = if List.IsEmpty(matching) then 0 else List.Last(matching)
		        in idx, Int64.Type
		    ),
		    FYCol = Table.AddColumn(FYAssignments, "FiscalYear", each Date.Year(FiscalYearStartDate) + [FiscalYearIndex], Int64.Type),
		    FYLCol = Table.AddColumn(FYCol, "FiscalYearLabel", each "FY" & Text.From([FiscalYear]), type text),
		    FYStartCol = Table.AddColumn(FYLCol, "FiscalYearStartDate", each FYStartDates{[FiscalYearIndex]}, type date),
		    DayInFYCol = Table.AddColumn(FYStartCol, "_DayInFY", each Duration.Days([Date] - [FiscalYearStartDate]), Int64.Type),
		    FWNCol = Table.AddColumn(DayInFYCol, "FiscalWeekNumber", each Number.RoundDown([_DayInFY] / 7) + 1, Int64.Type),
		    FPNCol = Table.AddColumn(FWNCol, "FiscalPeriodNumber", each
		        if Is13Period then
		            Number.Min(Number.RoundDown([_DayInFY] / 28) + 1, 13)
		        else
		            let
		                wn  = [FiscalWeekNumber],
		                qtr = Number.Min(Number.RoundDown((wn - 1) / WeeksPerQtr), 3),
		                wInQ = wn - qtr * WeeksPerQtr,
		                w1 = PeriodPattern_3{0},
		                w2 = PeriodPattern_3{1},
		                pInQ = if wInQ <= w1 then 1 else if wInQ <= w1 + w2 then 2 else 3
		            in
		                qtr * 3 + pInQ,
		        Int64.Type
		    ),
		    FPLCol = Table.AddColumn(FPNCol, "FiscalPeriodLabel", each "P" & Text.PadStart(Text.From([FiscalPeriodNumber]), 2, "0"), type text),
		    FQNCol = Table.AddColumn(FPLCol, "FiscalQuarterNumber", each Number.RoundUp([FiscalPeriodNumber] / (if Is13Period then 3.25 else 3)), Int64.Type),
		    FQCol = Table.AddColumn(FQNCol, "FiscalQuarter", each "FQ" & Text.From([FiscalQuarterNumber]), type text),
		    FWOPCol = Table.AddColumn(FQCol, "FiscalWeekOfPeriod", each
		        let
		            pn = [FiscalPeriodNumber],
		            wn = [FiscalWeekNumber]
		        in
		            if Is13Period then Number.Mod(wn - 1, 4) + 1
		            else
		                let
		                    qtr  = Number.RoundDown((pn - 1) / 3),
		                    pInQ = pn - qtr * 3,
		                    w1   = PeriodPattern_3{0},
		                    w2   = PeriodPattern_3{1},
		                    priorW = if pInQ = 1 then 0 else if pInQ = 2 then w1 else w1 + w2,
		                    wInQ   = wn - qtr * WeeksPerQtr
		                in
		                    wInQ - priorW,
		        Int64.Type
		    ),
		    Cleaned = Table.RemoveColumns(FWOPCol, {"FiscalYearIndex", "_DayInFY"})
		in
		    Cleaned
	lineageTag: fnCalendarWeekBased

