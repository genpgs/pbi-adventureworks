	partition Calendar = m
		mode: import
		source =
				let
					    FiscalYearStartDate = #date(2025, 2, 1),
				    WeekPattern         = "445",
				    WeekStartDay        = "Saturday",
					    NumberOfYears       = 5,
				    Calendar            = fnCalendarWeekBased(FiscalYearStartDate, NumberOfYears, WeekPattern, WeekStartDay, "en-US")
				in
				    Calendar

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

